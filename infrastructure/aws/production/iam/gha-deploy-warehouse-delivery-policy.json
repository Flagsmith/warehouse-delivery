{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EcrPushPullWarehouseDelivery",
            "Effect": "Allow",
            "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:DescribeImages",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
            ],
            "Resource": "arn:aws:ecr:eu-west-2:084060095745:repository/experimentation/warehouse-delivery"
        },
        {
            "Sid": "EcsServiceUpdateWarehouseDelivery",
            "Effect": "Allow",
            "Action": [
                "ecs:UpdateService",
                "ecs:DescribeServices"
            ],
            "Resource": "arn:aws:ecs:eu-west-2:084060095745:service/flagsmith-experimentation/warehouse-delivery"
        },
        {
            "Sid": "PassWarehouseDeliveryExecRoleToEcs",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::084060095745:role/warehouse-delivery-task-exec-role",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ecs-tasks.amazonaws.com"
                }
            }
        }
    ]
}
